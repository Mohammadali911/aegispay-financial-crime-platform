{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegispay.example/contracts/payment_event.schema.json",
  "title": "AegisPay Payment Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_timestamp", "transaction_id", "customer_id",
    "account_id", "merchant_id", "device_id", "ip_address", "amount",
    "currency", "payment_channel", "event_type", "source_sequence",
    "is_synthetic", "scenario_label"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_timestamp": {"type": "string", "format": "date-time"},
    "transaction_id": {"type": "string", "minLength": 1},
    "customer_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "merchant_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "ip_address": {"type": "string", "minLength": 1},
    "amount": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string", "enum": ["CAD", "USD", "EUR", "GBP"]},
    "payment_channel": {"type": "string", "enum": ["CARD_PRESENT", "ECOMMERCE", "MOBILE", "TRANSFER"]},
    "event_type": {"type": "string", "enum": ["AUTHORISATION", "CAPTURE", "REVERSAL", "TRANSFER"]},
    "source_sequence": {"type": "integer", "minimum": 1},
    "is_synthetic": {"const": true},
    "scenario_label": {
      "type": "string",
      "enum": ["LEGITIMATE", "PAYMENT_FRAUD", "ACCOUNT_TAKEOVER", "MULE_NETWORK", "LAYERING"]
    }
  }
}

