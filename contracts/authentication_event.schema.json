{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegispay.example/contracts/authentication_event.schema.json",
  "title": "AegisPay Authentication Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auth_event_id", "event_timestamp", "customer_id", "account_id",
    "session_id", "device_id", "ip_address", "country", "city",
    "auth_result", "failure_reason", "mfa_result", "user_agent",
    "source_sequence", "is_synthetic", "scenario_label"
  ],
  "properties": {
    "auth_event_id": {"type": "string", "minLength": 1},
    "event_timestamp": {"type": "string", "format": "date-time"},
    "customer_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "ip_address": {"type": "string", "minLength": 1},
    "country": {"type": "string", "minLength": 2, "maxLength": 2},
    "city": {"type": "string", "minLength": 1},
    "auth_result": {"type": "string", "enum": ["SUCCESS", "FAILURE"]},
    "failure_reason": {"type": ["string", "null"]},
    "mfa_result": {"type": "string", "enum": ["PASSED", "FAILED", "BYPASSED", "NOT_CHALLENGED"]},
    "user_agent": {"type": "string", "minLength": 1},
    "source_sequence": {"type": "integer", "minimum": 1},
    "is_synthetic": {"const": true},
    "scenario_label": {"type": "string", "enum": ["LEGITIMATE", "BRUTE_FORCE", "ACCOUNT_TAKEOVER"]}
  }
}
